{
  "manifest_version": 3,
  "name": "remove AI overview",
  "version": "1.0.0",
  "description": "injects simple JS code to remove AI overview components from Google search pages.",
  "permissions": [
    "storage"
  ],
  "icons": {
    "48": "icons/icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://google.com/search*",
        "https://google.com.br/search*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "my-addon-id@example.com",
      "strict_min_version": "109.0"
    }
  }
}